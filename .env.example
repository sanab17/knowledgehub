# KnowledgeHub Environment Variables Example
# Copy this file to '.env' and adjust values for your environment.

# Server Settings
SERVER_PORT=8080

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Storage Settings
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Session Settings
SPRING_SESSION_STORE_TYPE=jdbc

# Cloud Storage (S3 / MinIO) Settings
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_S3_BUCKET=knowledgehub

# RAG Settings (Spring AI)
# SPRING_AI_OPENAI_API_KEY=your-openai-api-key-here

